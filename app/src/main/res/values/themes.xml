<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      ============================================================================
      主题

      ⚠️⚠️ 陷阱 14（本项目踩过、AAPT 报 failed linking references）：
         **自定义 style 不要写 parent="Widget.XXX"** ——
         LinearLayout / FrameLayout 这类容器**根本没有** Widget.* 样式，
         前五道本地校验全绿也拦不住，只有云编译才炸。
         容器要继承只能省略 parent，或者用确定存在的 Widget.TextView / Button / ImageView。

      ⚠️ 陷阱 ①（同样踩过）：style 名字里的点要用 `.` 表示继承层级？
         不是 —— 我们这里**全部用扁平命名**（KachaXxx），不靠点做隐式继承，
         避免 AAPT 把 `Kacha.Btn` 当成 `Kacha` 的子样式去解析。
      ============================================================================
    -->

    <style name="Theme.Kacha" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_pressed</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 敲门页：全透明 + 无动画 + 透明遮罩，用户完全看不见 -->
    <style name="Theme.Kacha.Nudge" parent="Theme.Kacha">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!--
      ★ 底部弹层专用主题（「选目标 App」的 Dialog 用它）

      ⚠️⚠️ 为什么必须给 Dialog 单独一个主题 —— v1.0 点「添加应用」秒退的真凶在这：
        ① `Dialog(context)` 默认继承 **Activity 的主题**（Theme.Kacha），
           而 Activity 主题的 `windowIsFloating` 是 false →
           Dialog 会退化成「全屏窗口」，dim、点击外部关闭、布局都不对。
        ② 更要命：全屏窗口下想隐藏标题栏只能调
           `dialog.requestWindowFeature(Window.FEATURE_NO_TITLE)`，
           而这个方法**必须在 setContentView() 之前**调用，写在后面直接抛
           `AndroidRuntimeException: requestFeature() must be called before adding content`
           —— 用户看到的就是「点一下秒退」。

      → 解法：把「浮动 + 无标题 + 透明底 + dim」全套写进主题，
        代码里一次都不碰 requestWindowFeature，从根上没这个机会犯错。

      ⚠️ parent 用 Theme.Kacha（不是 Material 的 Dialog 主题）：
         少引一个不确定存在的外部 parent，避免 AAPT failed linking references（陷阱 ⑬）。
    -->
    <style name="Theme.Kacha.Sheet" parent="Theme.Kacha">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <!-- 弹层要通栏，别被浮动窗口的最小宽度特性卡住 -->
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <!-- ==================== 文字 ==================== -->
    <style name="KachaText" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaSectionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaSubTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaRowTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaRowSub" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ==================== 卡片 ==================== -->
    <style name="KachaCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- ==================== 按钮（手绘底，不用系统 StateList）==================== -->
    <style name="KachaButton" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaButtonPrimary" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaChip" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KachaChipOn" parent="KachaChip">
        <item name="android:background">@drawable/bg_chip_on</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="KachaSwitch">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">30dp</item>
    </style>

</resources>
