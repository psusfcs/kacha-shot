<?xml version="1.0" encoding="utf-8"?>
<!-- ★ Android 13+ 主题图标（monochrome）：纯色剪影，系统拿它自己染色。
     所以这里**只用一种颜色**（系统会忽略实际色值），造型跟前景一致。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M43,31 l3.6,-7 a3.4,3.4 0 0 1 3.0,-1.9 h8.8 a3.4,3.4 0 0 1 3.0,1.9 l3.6,7 h13 a8,8 0 0 1 8,8 v27 a8,8 0 0 1 -8,8 h-56 a8,8 0 0 1 -8,-8 v-27 a8,8 0 0 1 8,-8 z"
        android:fillColor="#FFFFFF" />

    <!-- 快门圈挖空（用更亮的色差示意，系统染色后仍能看出层次） -->
    <path
        android:pathData="M54,52 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5" />
</vector>
