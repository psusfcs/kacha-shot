<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  ★ 长截图遮罩（上下两条细边条，中间完全透出内容）

  ── 为什么不是全屏黑布（老 App v5.3 的教训）──
    ① 全屏遮罩每抓一帧都要摘/装，一摘一装就是一闪 —— 遮罩越大闪得越厉害；
    ② 全屏把内容挡死了，用户看不出来它在滚，会自己上手滑，把拼接搞乱。
    所以只在顶部/底部各留一条，中间完全透出。

  ⚠️ 根节点：match_parent + clickable="true"，**背景必须为空**
     —— 它的作用是「吃掉触摸」，不是「遮住视线」。加了 background 就前功尽弃。
  ============================================================================
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- ============ 顶部边条：转圈 + 进度 ============ -->
    <LinearLayout
        android:id="@+id/guardTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_guard_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/tvGuardText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/tip_scrolling"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ============ 底部边条：说明 + 停下 ============ -->
    <LinearLayout
        android:id="@+id/guardBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_guard_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="13dp"
        android:paddingRight="18dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/tvGuardSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/scroll_guard_sub"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnGuardStop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_guard_stop"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="@string/scroll_guard_stop"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
