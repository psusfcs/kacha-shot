<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  ★ 首页 = 唯一的设置页（手绘 UI）

  结构（从上往下）：
    1. 标题区      咔嚓截屏 + 一句话说明
    2. 状态卡片    悬浮窗 / 截屏权限 / 悬浮球 —— 三个开关一一列出来
    3. 目标卡片    「截完发给谁」：已添加的应用列表 + 添加按钮
    4. 动作卡片    存相册 / 放剪贴板 / 自动送过去（三个开关）
    5. 用法卡片    怎么用 + 几个要提前知道的事
    6. 版本号

  ⚠️ 最外层 ScrollView：内容比屏幕长，必须能滚。
     内层 LinearLayout 用 paddingBottom 留出底部安全区（手势条）。
  ============================================================================
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="28dp"
        android:paddingRight="18dp"
        android:paddingBottom="40dp">

        <!-- ==================== 1. 标题区 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/bg_ball" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_title"
                    style="@style/KachaTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/home_subtitle"
                    style="@style/KachaSubTitle" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 2. 状态卡片 ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/section_status"
            style="@style/KachaSectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/KachaCard">

            <!-- 悬浮窗权限 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivOverlayState"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/status_overlay"
                    android:src="@drawable/ic_warn" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_overlay"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:id="@+id/tvOverlayState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/status_overlay_off"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_open_overlay"
                    style="@style/KachaChip" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- 截屏权限 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivAccState"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/status_acc"
                    android:src="@drawable/ic_warn" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_acc"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:id="@+id/tvAccState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/status_acc_off"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAcc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_open_acc"
                    style="@style/KachaChip" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!-- 悬浮球开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivBallState"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/status_ball"
                    android:src="@drawable/ic_warn" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_ball"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:id="@+id/tvBallState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/status_ball_off"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnBallToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_ball_toggle_on"
                    style="@style/KachaButtonPrimary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <!--
              后台弹出界面（v1.6）：小米系专属的隐形杀手权限 ——
              默认禁止时，后台启动 Activity 被**静默拦截**（不报错也不跳转）。
              ⚠️ 整行只在小米系手机上显示（代码控制 rowJumpState.visibility），
                 其它 ROM 没有这个权限概念，显示了反而让用户懵。
            -->
            <LinearLayout
                android:id="@+id/rowJumpState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivJumpState"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/status_jump"
                    android:src="@drawable/ic_check" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_jump"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:id="@+id/tvJumpState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/status_jump_ok"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnJumpFix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_jump_fix"
                    style="@style/KachaChip" />
            </LinearLayout>

            <!--
              「使用情况访问权」行（v2.1）：
              判断「目标 App 后台还开着吗」的依据 —— 开了它，截图时才能把
              后台挂着的目标 App 原样切回前台（而不是新开一个会话）。
              特殊权限没法弹框申请，只能引导用户去系统设置手动开。
            -->
            <LinearLayout
                android:id="@+id/rowUsageState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivUsageState"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/status_usage"
                    android:src="@drawable/ic_check" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_usage"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:id="@+id/tvUsageState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/status_usage_off"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnUsageFix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_usage_fix"
                    style="@style/KachaChip" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 3. 目标 App 卡片 ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_target"
            style="@style/KachaSectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/KachaCard">

            <!-- 默认发给 X -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_default_label"
                    style="@style/KachaRowTitle" />

                <TextView
                    android:id="@+id/tvDefaultTarget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/target_none_chosen"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!--
                  折叠开关（v1.6）：加了几个目标之后，整排 chip 会把首屏拉满 ——
                  默认只露「默认发给 X」，点这里才展开完整列表。
                  文字由代码填（带已加数量）。
                -->
                <TextView
                    android:id="@+id/tvTargetsToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="10dp"
                    android:paddingTop="6dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="6dp"
                    android:text="@string/targets_toggle_expand"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 空态提示 -->
            <TextView
                android:id="@+id/tvTargetEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/target_empty"
                style="@style/KachaRowSub" />

            <!-- 已添加的应用列表（代码往里塞行） -->
            <LinearLayout
                android:id="@+id/boxTargets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnAddTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/target_add"
                style="@style/KachaButton" />
        </LinearLayout>

        <!-- ==================== 4. 导出动作卡片 ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_switch"
            style="@style/KachaSectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/KachaCard">

            <!-- 存相册 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sw_gallery"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/sw_gallery_sub"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="13dp"
                android:background="@color/divider" />

            <!-- 放剪贴板 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sw_clipboard"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/sw_clipboard_sub"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swClipboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="13dp"
                android:background="@color/divider" />

            <!-- 自动送过去 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sw_auto_send"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/sw_auto_send_sub"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="13dp"
                android:background="@color/divider" />

            <!-- 开机自启 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sw_boot"
                        style="@style/KachaRowTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/sw_boot_sub"
                        style="@style/KachaRowSub" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swBoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 5. 用法卡片 ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_help"
            style="@style/KachaSectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/KachaCard">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="9dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_line1"
                style="@style/KachaRowSub"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_line2"
                style="@style/KachaRowSub"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_line3"
                style="@style/KachaRowSub"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_line4"
                style="@style/KachaRowSub"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="13dp"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_note_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_note1"
                style="@style/KachaRowSub" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_note2"
                style="@style/KachaRowSub" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_note3"
                style="@style/KachaRowSub" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/help_note4"
                style="@style/KachaRowSub" />

        </LinearLayout>

        <!-- ==================== 6. 版本号 ==================== -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
