<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  「咔嚓截屏」清单文件

  ── 这个 App 一共只干三件事 ──
    ① 悬浮球（点 = 截当前屏 / 长按 = 自动滚动截长图）
    ② 截图（无障碍 takeScreenshot，一次授权永久免弹框）
    ③ 把图交出去（分享跳转目标 App + 存相册 + 放剪贴板，三连同时走）

  ── 权限为什么这么少 ──
    · SYSTEM_ALERT_WINDOW    —— 悬浮球必须的（画在别的 App 上面）
    · FOREGROUND_SERVICE     —— 球要常驻，不加会被系统随手杀
    · FOREGROUND_SERVICE_SPECIAL_USE —— Android 14+ 前台服务必须声明具体类型
    · POST_NOTIFICATIONS     —— Android 13+ 常驻通知要用户点同意
    ★ 刻意**不要**的：
      · READ/WRITE_EXTERNAL_STORAGE —— 走 MediaStore 存相册，Android 10+ 免权限
      · QUERY_ALL_PACKAGES          —— 用 queryIntentActivities 按「能收图」筛选即可，
                                       全量列包名属于过度申请，上架/审核都会被质疑
      · INTERNET                    —— 这个 App 不联网，一个字都不传出去
  ============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮球 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 常驻前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启（用户可选；部分 ROM 需要用户在系统里单独放行） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      使用情况访问权（v2.1）：判断「目标 App 后台还开着吗」——
      Android 8.0 起 getRunningAppProcesses 对普通应用只返回自己的进程，
      官方唯一合规路子是 UsageStatsManager，而它要求这条 protected 权限
      （用户在系统设置里手动授予，首页状态行有一键跳转）。
      没授权时自动退回「直接分享」的老行为，不影响主流程。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      ★ 快捷方式自愈（HyperOS 常用）：升级后图标可能变灰/消失，声明这条让系统重建。
      ★ 这条同时也是「能查到其他 App」的前提 —— Android 11+ 的包可见性机制要求：
        不在这里声明，queryIntentActivities 就**查不到**别的 App。

      ⚠️⚠️ 这里的匹配规则非常反直觉，v1.2 踩了个来回，务必看完再改：

        ① **不能只写 <action>、不写 <data>**（v1.2 就是这么写的，结果列表里
           只剩「保存到本地 / 打印 / 蓝牙」这些系统组件，微信一个都出不来）。
           原因：query 的 type 为 null 时，**匹配不上任何声明了 data 类型的组件** ——
           而微信这类 App 全都声明了。所以「不写 data」不是变宽，是变窄。

        ② **也不能只写一个 mimeType**（v1.1 只写了 image 通配，微信也出不来）。
           原因：这里用的是 IntentFilter 的**精确匹配**，没有「反向通配」——
           query 写 image 通配，匹配不上只写「所有类型」的 App。

        → 唯一稳妥的写法：**把常见写法全都列一遍，多条并集**（多条之间是 OR）。

      ⚠️ 真正的筛选和排序在代码里做（AppFinder）——
         这里只要「能让系统放行我们看见它」就够了，范围宁大勿小。
    -->
    <queries>
        <!-- ① 收图片的：微信、QQ、小红书、豆包这类都在这条 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- ② 声明了「所有类型」的 App（只写一条 mimeType 会漏掉它们） -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- ③ 收纯文本的（有些 App 的分享入口只声明了 text） -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- ④ 完全不限定类型的（不少系统组件是这么写的） -->
        <intent>
            <action android:name="android.intent.action.SEND" />
        </intent>
    </queries>

    <application
        android:name=".KachaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kacha"
        tools:targetApi="34">

        <!-- ==================== 首页 = 设置页 ==================== -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ==================== 敲门页（一闪而过的透明页）====================
          ★ 用途：无障碍服务被 ROM 回收后，系统里明明还勾选着、但实例已经没了。
            开一个一闪而过的 Activity = 制造一波真实的窗口切换事件，
            系统被惊动后会重新检查「勾选的无障碍服务都绑上了吗」→ 补绑。
          ★ 为什么能后台启动它：本 App 持有 SYSTEM_ALERT_WINDOW，
            在 Android 10+ 的后台启动 Activity 豁免名单里。
          ★ 用户完全看不见（theme 全透明、无动画、即刻 finish）。
        -->
        <activity
            android:name=".ui.NudgeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kacha.Nudge" />

        <!--
          ==================== 长图裁剪页（v1.2 新增）====================
          ★ 长截图拼好之后进这里：图片可上下滚着看，拖上下两根把手剪掉不要的部分，
            点「完成」才导出。单屏截图**不**进这里（没得裁，弹了反而啰嗦）。
          ★ excludeFromRecents：它是临时页，不该出现在「最近任务」里 ——
            用户在最近任务里看到它、切回来，会对着一张不知道哪来的图发懵。
          ★ 图不走 Intent 传（长图塞 Intent 必崩 TransactionTooLargeException），
            走同进程静态字段 CropBus。
        -->
        <activity
            android:name=".ui.CropActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kacha.Crop" />

        <!-- ==================== 悬浮球服务 ==================== -->
        <service
            android:name=".service.FloatBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="悬浮球常驻，用于随时一键截屏" />
        </service>

        <!-- ==================== 截图无障碍服务 ==================== -->
        <service
            android:name=".service.ShotAccessibilityService"
            android:exported="true"
            android:label="@string/acc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          ==================== FileProvider ====================
          ★ 分享 / 剪贴板给别的 App 传图必须走 content:// uri。
            直接给 file:// 从 Android 7 起会抛 FileUriExposedException 崩掉。
          ★ authority 必须和 Exporter.kt 里拼的 "${'$'}{packageName}.fileprovider" 一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 开机自启（用户开了「开机自动启动悬浮球」才生效） -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
