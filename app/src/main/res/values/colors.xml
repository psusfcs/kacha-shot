<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  ★ 配色：米白暖底 + 一点橘（呼应「咔嚓」的快门感）
    不用纯白纯黑 —— 纯白刺眼、纯黑发灰，暖一点更耐看。

  ⚠️ 深色模式在 values-night/colors.xml 里整套覆盖，两边资源名必须一一对应。
  ============================================================================
-->
<resources>
    <!-- 背景 -->
    <color name="bg">#FFF7F3EC</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_alt">#FFF1EAE0</color>
    <color name="divider">#1A000000</color>

    <!-- 文字 -->
    <color name="text_primary">#FF1C1A17</color>
    <color name="text_secondary">#FF6B6560</color>
    <color name="text_tertiary">#FF9A938C</color>
    <color name="text_on_accent">#FFFFFFFF</color>

    <!-- 主色：快门橘 -->
    <color name="accent">#FFF0743C</color>
    <color name="accent_soft">#1FF0743C</color>
    <color name="accent_pressed">#FFD85F28</color>

    <!-- 状态 -->
    <color name="ok">#FF2E9E63</color>
    <color name="warn">#FFD99A1C</color>
    <color name="danger">#FFD8443C</color>

    <!-- 悬浮球 -->
    <color name="ball_fill">#F2FFFFFF</color>
    <color name="ball_ring">#33FFFFFF</color>
    <color name="ball_icon">#FFF0743C</color>

    <!-- 滚动遮罩两条边条 -->
    <color name="guard_bar">#D91C1A17</color>

    <!-- 透明（敲门户 / 遮罩根节点用） -->
    <color name="transparent">#00000000</color>
</resources>
