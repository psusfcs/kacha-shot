<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 悬浮球球体：暖白圆形 + 柔和双层阴影（layer-list 叠两层做景深）
    为什么用 layer-list 而不是 elevation：TYPE_APPLICATION_OVERLAY 窗口的
    elevation 在部分 ROM 上不生效（阴影会被裁掉），自己画最稳。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈阴影 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#14000000" />
            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
    <!-- 主球体（略小一圈，露出外圈阴影） -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/ball_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/ball_ring" />
        </shape>
    </item>
</layer-list>
