<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 选择目标 App 的弹层（底部滑出，用 Dialog 承载）

  ⚠️ 用 Dialog + 这个布局，不是 DialogFragment —— 少一层依赖，够用。
     列表由代码动态填充（queryIntentActivities 的结果）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:text="@string/target_pick_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:text="@string/target_pick_sub"
        style="@style/KachaRowSub" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:maxHeight="420dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/boxPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </ScrollView>

    <TextView
        android:id="@+id/btnPickerCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="20dp"
        android:text="@string/dialog_cancel"
        style="@style/KachaButton" />
</LinearLayout>
